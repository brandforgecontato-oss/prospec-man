{
  "name": "brandforge-prospecting",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/run.ts",
    "dev:all": "concurrently -n next,worker -c blue,green \"pnpm dev\" \"pnpm worker\"",
    "test": "vitest run",
    "dry-run:profile": "tsx --env-file-if-exists=.env src/scripts/dry-run-profile.ts",
    "dry-run:dm": "tsx --env-file-if-exists=.env src/scripts/dry-run-dm.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.6",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.8.1"
}
