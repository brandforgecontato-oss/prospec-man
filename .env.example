# Copie este arquivo para .env e preencha com valores reais.
# .env nunca vai para o Git (ver .gitignore) — veja SETUP.md para o passo a passo completo.

# --- Banco de dados ---
# Caminho do arquivo SQLite. Padrão: data/brandforge.db (pasta gitignored).
DATABASE_URL=data/brandforge.db

# --- OpenAI (motor de conversação) ---
# Crie a chave em https://platform.openai.com/api-keys, num projeto separado,
# permissão "Restricted", e defina um hard limit mensal em Settings → Limits.
OPENAI_API_KEY=
# Nomes exatos de modelo — sem alias flutuante em produção (prompt.MD).
OPENAI_MODEL=
OPENAI_MODEL_FAST=
# Teto mensal em USD. Ao ser atingido, o sistema pausa sozinho (circuit breaker).
OPENAI_MONTHLY_BUDGET_USD=

# --- Chrome / Playwright (CDP) ---
# Suba o Chrome com um perfil dedicado e debug em 127.0.0.1 (nunca 0.0.0.0,
# nunca em máquina compartilhada — a porta de debug dá controle total da
# sessão logada). Comandos por SO em SETUP.md. Logue no Instagram uma vez.
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=.chrome-profile

# --- Ritmo humano (envio pelo navegador) ---
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
# Formato "HH:MM-HH:MM", no fuso de OPERATING_TIMEZONE.
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# --- Instagram — Webhook e API oficial (Meta) ---
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Opcionais — têm default sensato no código, só mude se souber por quê.
# INSTAGRAM_GRAPH_API_VERSION=v21.0
# INSTAGRAM_MESSAGING_WINDOW_HOURS=24
# INSTAGRAM_GRAPH_API_BASE_URL só existe para apontar os testes a um servidor
# fake — NUNCA definir em produção (substituiria a Graph API de verdade).

# --- Worker (fila de jobs) — opcionais, já têm default sensato ---
# WORKER_POLL_INTERVAL_MS=5000
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_BASE_MS=30000
# JOB_BACKOFF_MAX_MS=3600000
# Pausa automática (circuit breaker) por taxa de erro anormal:
# JOB_ERROR_RATE_THRESHOLD=5
# JOB_ERROR_RATE_WINDOW_MS=900000
